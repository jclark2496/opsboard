# Copy to .env for local collect / dev. Never commit .env.
# Values stay in the environment. The dashboard config stores only the variable names.

# Optional. Public repositories can be read without a token, within the anonymous rate limit.
# GITHUB_TOKEN=

# Pinned host keys for ssh-uptime, one line per host. Not a private key.
# SSH_KNOWN_HOSTS=

# Private key material for a machine. The config names this variable; it does not contain the key.
# SSH_KEY_ACME_VPS_1=

# Per-host heartbeat tokens. The reporter sends one. The collector never prints it.
# HEARTBEAT_TOKEN_ACME_VPS_1=

# Required only when the dev server's write API is reachable beyond localhost.
# SETTINGS_TOKEN=
